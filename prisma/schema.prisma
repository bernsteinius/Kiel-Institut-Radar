// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventCategory {
  MONETARY_POLICY // FED, EZB, andere Zentralbanken
  TRADE_CHINA // EU-China, Exportbeschränkungen, Handelspolitik
  SECURITY_DEFENSE // NATO, Defence-Gipfel
  INSTITUTIONS // G7, G20, IWF, Weltbank, EU-Gipfel
  FISCAL_BUDGET // Haushaltsdebatten, Fiskalpolitik
  IFW_EVENTS // Eigene Veranstaltungen des IfW Kiel
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum EventType {
  MEETING // Sitzung / Meeting
  SUMMIT // Gipfel
  DECISION // Entscheidung / Beschluss
  EVENT // Veranstaltung
  PUBLICATION // Paper / Publikation
  DEADLINE // Frist
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
}

enum ConfirmationStatus {
  CONFIRMED
  TENTATIVE
}

model Event {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime?
  allDay             Boolean             @default(true)
  category           EventCategory
  type               EventType           @default(EVENT)
  status             EventStatus         @default(DRAFT)
  source             String?
  sourceUrl          String?
  location           String?
  institutions       String?
  priority           EventPriority       @default(MEDIUM)
  confirmationStatus ConfirmationStatus  @default(CONFIRMED)
  /// Teilnehmer Kiel Institut: manuell erfasste Namen, nur bei type=EVENT relevant
  participants       String[]            @default([])
  /// Kiel-Institut-Themen (offizielle Taxonomie), nur bei type=PUBLICATION relevant,
  /// eine Publikation kann mehreren Themen zugeordnet sein
  topics             String[]            @default([])
  attachments        EventAttachment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([startDate])
}

/// Hochgeladene PDF-Quellennachweise zu einem manuell angelegten Termin.
/// Ein Event kann mehrere Anhänge haben.
model EventAttachment {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  fileName  String
  fileType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([eventId])
}

/// Von Nutzern hinzugefügte Suchthemen: der tägliche Job liest die
/// angegebene URL und sucht dort heuristisch nach Datumsangaben.
model Topic {
  id        String        @id @default(cuid())
  name      String
  url       String
  category  EventCategory @default(OTHER)
  createdAt DateTime      @default(now())
}
