# Von Neon (https://neon.tech) nach dem Anlegen der Datenbank kopieren
# (die "direct connection"-Variante, nicht die gepoolte - der Neon-Adapter
# von Prisma verwaltet das Pooling selbst).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Gemeinsames Passwort für den Kalender-Zugang (für alle Nutzer gleich).
SITE_PASSWORD="change-me"

# Zufälliger String (mind. 32 Zeichen) zum Signieren der Session-Cookies.
# Generieren mit: openssl rand -base64 32
SESSION_SECRET=""

# Geheimnis für den täglichen Cron-Job. Vercel schickt es automatisch als
# "Authorization: Bearer <CRON_SECRET>"-Header mit, wenn diese Env-Variable gesetzt ist.
# Generieren mit: openssl rand -hex 16
CRON_SECRET=""
